# =============================================================================
# Ormakkoodu — environment template
# Copy this file to .env.local (Next.js) and never commit real values.
# Association branding lives in src/config/site.ts; secrets live here only.
# =============================================================================

# Public site URL (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Service role key — server and operator scripts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional: used by scripts/bootstrap-admin.ts if you do not pass --email
BOOTSTRAP_ADMIN_EMAIL=

# Public email for removal requests and archive mail. There is no grievance officer;
# GECIAN alumni volunteers handle contact themselves. Also stored in settings.
NEXT_PUBLIC_CONTACT_EMAIL=archive@example.org

# Google OAuth (Supabase Auth → Providers → Google)
# Local CLI reads these as SUPABASE_AUTH_EXTERNAL_GOOGLE_* (see supabase/config.toml).
# Hosted project: paste the same values in the Supabase dashboard, not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# GitHub Actions keep-alive and purge workflows store SITE_URL / PURGE_SECRET
# as repository secrets, not in this file.
